# Copy to `.env` and adjust before `docker compose up --build`.
# Compose reads `.env` automatically; every value has a working local default.

# Production or Development (Development relaxes the JWT secret requirement).
ASPNETCORE_ENVIRONMENT=Production

# At least 32 characters. Replace it in any shared or public environment.
JWT_CLAVE_SECRETA=cambie-esta-clave-de-al-menos-32-caracteres

# Host ports. The container always listens on 8080 (API) and 80 (web).
PUERTO_API=5080
PUERTO_WEB=8080
PUERTO_WEB_DESARROLLO=5173

# Origins allowed to call the API directly from a browser. The bundled UI talks
# to the same origin through nginx, so this only matters for external clients.
CORS_ORIGENES=http://localhost:8080,http://localhost:5173

# Image tag used by both services and by the test runner.
ETIQUETA_IMAGEN=local
