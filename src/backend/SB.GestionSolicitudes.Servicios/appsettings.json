{
  "ConnectionStrings": {
    "BaseDatos": "Server=localhost,1433;Database=SBGestionSolicitudes;User Id=sa;Encrypt=True;TrustServerCertificate=True"
  },
  "AlmacenEntidadesGubernamentales": {
    "RutaArchivo": "entidades-gubernamentales.json",
    "RutaSemilla": "entidades-gubernamentales.seed.json"
  },
  "Jwt": {
    "Emisor": "SB.GestionSolicitudes",
    "Audiencia": "SB.GestionSolicitudes.Cliente",
    "ClaveSecreta": "",
    "MinutosVigencia": 120
  },
  "Cors": {
    "Origenes": "http://localhost:5173,http://localhost:4173"
  },
  "Documentacion": {
    "Habilitada": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/sb-gestion-solicitudes-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
