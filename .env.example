# Copy to `.env` and adjust before `docker compose up --build`.
# Compose reads `.env` automatically; set the required credentials before use.

# Production or Development (Development relaxes the JWT secret requirement).
ASPNETCORE_ENVIRONMENT=Production

# At least 32 characters. Generate a unique value for your environment.
JWT_CLAVE_SECRETA=

# Host ports. The container always listens on 8080 (API) and 80 (web).
PUERTO_API=5080
PUERTO_WEB=8080
PUERTO_WEB_DESARROLLO=5173

# Host port for the demo SQL Server container; the container always listens on
# 1433. Exposed so SSMS or a host `dotnet run` can reach the same instance.
PUERTO_SQLSERVER=1433

# Required SA password of the `sqlserver` service. Use a unique strong value;
# Compose shares it with the API and test runner without storing it in source.
SQLSERVER_CLAVE_SA=

# The `api` service receives ConnectionStrings__BaseDatos built from
# SQLSERVER_CLAVE_SA and pointing at `sqlserver:1433`. `appsettings.json` alone
# cannot change it, because the container environment wins. To use an external
# SQL Server, add an override file that replaces the variable, for example:
#   services:
#     api:
#       environment:
#         ConnectionStrings__BaseDatos: "Server=mi-servidor,1433;Database=SBGestionSolicitudes;User Id=sa;Password=${SQLSERVER_CLAVE_SA};Encrypt=True;TrustServerCertificate=True"
# The containerized test runner uses its own `sqlserver` service; to point it
# elsewhere, override ConnectionStrings__BaseDatosPruebas with `Database=master`.
# Locally (`dotnet test`) the integration tests need nothing: Testcontainers
# starts a disposable SQL Server for the run. Defining the variable here would
# replace that container with your instance.

# Origins allowed to call the API directly from a browser. The bundled UI talks
# to the same origin through nginx, so this only matters for external clients.
CORS_ORIGENES=http://localhost:8080,http://localhost:5173

# Image tag used by both services and by the test runner.
ETIQUETA_IMAGEN=local
